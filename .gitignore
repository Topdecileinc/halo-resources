.DS_Store
send-email

# Python bytecode cache (build/validation tooling)
__pycache__/
*.pyc

# Figma fetch artifacts — temporary CI inputs, never source
_figma_in/

# Brief form submissions (runtime data, not source)
submissions/*
!submissions/.gitkeep

# Pipeline config holds API keys — never commit it
brief/config.php

# Generated emails (runtime output)
generated/*
!generated/.gitkeep

brief/.htaccess
